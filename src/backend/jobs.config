{
    "jobs": [
        {
            "functionLocation": "/translationCron.web.js",
            "functionName": "processTranslationQueue",
            "description": "Process pending property translations - hourly",
            "executionConfig": {
                "cronExpression": "0 * * * *"
            }
        },
        {
            "functionLocation": "/kwSync.web.js",
            "functionName": "syncKw7Feed",
            "description": "Sync KW7 property feed - daily 2:30AM",
            "executionConfig": {
                "cronExpression": "30 2 * * *"
            }
        },
        {
            "functionLocation": "/kwPipeline.web.js",
            "functionName": "processKw7PipelineCron",
            "description": "Organize images + detect/clean watermarks - hourly",
            "executionConfig": {
                "cronExpression": "30 * * * *"
            }
        }
    ]
}